<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything a front end needs to run Joust, with no window, audio device or file system:
       the desktop app uses it today, and a browser or phone front end can use it as is. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Joust.Assembler\Joust.Assembler.csproj" />
    <ProjectReference Include="..\Joust.Emulation\Joust.Emulation.csproj" />
    <ProjectReference Include="..\Joust.Port\Joust.Port.csproj" />
    <ProjectReference Include="..\Joust.Render\Joust.Render.csproj" />
  </ItemGroup>

</Project>
