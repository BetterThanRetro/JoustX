<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No per-build Joust.App.exe: Smart App Control blocks that unsigned launcher at random,
         so `dotnet run` starts the game through the signed dotnet.exe instead. -->
    <UseAppHost>false</UseAppHost>
    <!-- Methods with loops (the renderer's per-pixel work) get optimized code on their first
         call, not after a slow first phase: that phase made the first draws take up to 170 ms,
         and the fixed time step then ran a burst of frames whose sound overflowed the queue. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <!-- The GPU renderer's per-pixel uploads run here every frame, also in a Debug `dotnet run`. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4" />
  </ItemGroup>

  <!-- The window icon (DesktopGL loads an embedded "Icon.bmp"): player 1's knight, cut from the
       game by `joust-tools make-icon`. Icon.ico holds the same picture at 16-256 px. -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <None Include="Icon.ico" />
  </ItemGroup>

  <!-- The HD shaders. Hd.mgfxo is checked in; it is rebuilt from Hd.fx when that changes, with
       the repository's mgfxc tool ("dotnet tool restore" once). Without the tool the build warns
       and keeps the checked-in shaders. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\Hd.mgfxo" LogicalName="Hd.mgfxo" />
    <None Include="Shaders\Hd.fx" />
  </ItemGroup>
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" Inputs="Shaders\Hd.fx" Outputs="Shaders\Hd.mgfxo">
    <Exec Command="dotnet mgfxc Shaders/Hd.fx Shaders/Hd.mgfxo /Profile:OpenGL" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Joust.Host\Joust.Host.csproj" />
  </ItemGroup>

</Project>
