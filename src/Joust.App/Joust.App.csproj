<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No per-build Joust.App.exe: Smart App Control blocks that unsigned launcher at random,
         so `dotnet run` starts the game through the signed dotnet.exe instead. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4" />
  </ItemGroup>

  <!-- The window icon (DesktopGL loads an embedded "Icon.bmp"): player 1's knight, cut from the
       game by `joust-tools make-icon`. Icon.ico holds the same picture at 16-256 px. -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <None Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Joust.Emulation\Joust.Emulation.csproj" />
    <ProjectReference Include="..\Joust.Assembler\Joust.Assembler.csproj" />
    <ProjectReference Include="..\Joust.Port\Joust.Port.csproj" />
    <ProjectReference Include="..\Joust.Render\Joust.Render.csproj" />
  </ItemGroup>

</Project>
